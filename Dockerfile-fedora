FROM php:5.6-apache

# --------------------------------------------------
# Repos legacy
# --------------------------------------------------

RUN sed -i 's|deb.debian.org|archive.debian.org|g' /etc/apt/sources.list \
    && sed -i 's|security.debian.org|archive.debian.org|g' /etc/apt/sources.list \
    && sed -i '/stretch-updates/d' /etc/apt/sources.list

# --------------------------------------------------
# Desactivar validaciones expiradas
# --------------------------------------------------

RUN echo 'Acquire::Check-Valid-Until "false";' \
    > /etc/apt/apt.conf.d/99no-check-valid

RUN echo 'Acquire::AllowInsecureRepositories "true";' \
    >> /etc/apt/apt.conf.d/99no-check-valid

RUN echo 'APT::Get::AllowUnauthenticated "true";' \
    >> /etc/apt/apt.conf.d/99no-check-valid

# --------------------------------------------------
# Update
# --------------------------------------------------

RUN apt-get -o Acquire::Check-Valid-Until=false update

# --------------------------------------------------
# Dependencias compilación PHP
# --------------------------------------------------

RUN apt-get install -y --allow-unauthenticated \
    gcc \
    make \
    autoconf \
    libc-dev \
    pkg-config \
    libmariadb-dev \
    mariadb-client \
    nano \
    vim \
    unzip \
    curl \
    wget

# --------------------------------------------------
# MYSQLND
# --------------------------------------------------

RUN docker-php-ext-configure mysqli --with-mysqli=mysqlnd

# --------------------------------------------------
# Instalar extensiones
# --------------------------------------------------

RUN docker-php-ext-install mysqli pdo pdo_mysql

# --------------------------------------------------
# Habilitar extensiones
# --------------------------------------------------

RUN docker-php-ext-enable mysqli pdo_mysql

# --------------------------------------------------
# Apache Fedora/Podman
# --------------------------------------------------

ENV APACHE_RUN_USER=www-data
ENV APACHE_RUN_GROUP=www-data
ENV APACHE_LOG_DIR=/var/log/apache2
ENV APACHE_RUN_DIR=/tmp/apache-run
ENV APACHE_LOCK_DIR=/tmp/apache-run
ENV APACHE_PID_FILE=/tmp/apache-run/apache2.pid

# --------------------------------------------------
# ServerName
# --------------------------------------------------

RUN echo "ServerName localhost" >> /etc/apache2/apache2.conf

# --------------------------------------------------
# Runtime dirs
# --------------------------------------------------

RUN mkdir -p /tmp/apache-run \
    && mkdir -p /var/log/apache2 \
    && chown -R www-data:www-data /tmp/apache-run

# --------------------------------------------------
# PID fuera /var/run
# --------------------------------------------------

RUN echo "PidFile /tmp/apache-run/apache2.pid" \
    > /etc/apache2/conf-available/custom-pid.conf

RUN a2enconf custom-pid

# --------------------------------------------------
# mod_rewrite
# --------------------------------------------------

RUN a2enmod rewrite

# --------------------------------------------------
# AllowOverride
# --------------------------------------------------

RUN sed -i '/<Directory \/var\/www\/>/,/<\/Directory>/ s/AllowOverride None/AllowOverride All/' \
    /etc/apache2/apache2.conf

# --------------------------------------------------
# Workdir
# --------------------------------------------------

WORKDIR /var/www/html

# --------------------------------------------------
# Puerto
# --------------------------------------------------

EXPOSE 80

# --------------------------------------------------
# Verificación mysqli
# --------------------------------------------------

RUN php -m | grep mysqli

# --------------------------------------------------
# Apache test
# --------------------------------------------------

RUN apache2ctl configtest

# --------------------------------------------------
# Startup
# --------------------------------------------------

CMD ["apache2ctl", "-D", "FOREGROUND"]
